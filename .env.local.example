# ---- Supabase (get these from Supabase Dashboard -> Settings -> API) ----
# The anon key is safe for the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# The service key is SERVER-ONLY. Never expose it to the browser / never
# prefix it with NEXT_PUBLIC_. It is used only by API routes for seeding.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# If no Supabase URL is configured, the app automatically falls back to
# bundled DEMO data so it always works offline for the hackathon demo.
